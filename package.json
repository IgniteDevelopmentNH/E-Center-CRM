{
  "name": "unh-ecenter-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight, multi-tenant CRM for the UNH Entrepreneurship Center",
  "license": "UNLICENSED",
  "workspaces": ["server", "client"],
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "reset": "npm run reset --workspace server",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace client",
    "test": "npm run test --workspace server"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
