###############################################################################
# UNH ECenter CRM -- local development environment
#
# This file only configures the LOCAL dev server (worker/dev/dev-server.mjs),
# which runs the real Worker against Node-backed shims for D1/R2 (see its
# header comment for why -- wrangler dev can't run on this machine).
#
# Production configuration is NOT set here. It lives in wrangler.toml ([vars],
# non-secret) and in Cloudflare secrets (`wrangler secret put NAME`, for
# JWT_SECRET / ENCRYPTION_KEY). See README -- Deployment.
###############################################################################

# Port for the local Worker dev server (npm run dev:api).
PORT=8788

# Public URL of the app. Used only in the Outlook-connect callback page's
# "Back to settings" link.
APP_URL=http://localhost:5173

# --- Secrets (local dev only) -------------------------------------------------
# Generate each with: openssl rand -hex 32
# JWT_SECRET signs session lookups and the two short-lived HMAC tokens
# (document downloads, the Microsoft OAuth state parameter). ENCRYPTION_KEY
# encrypts Microsoft OAuth secrets/tokens at rest (AES-256-GCM). If left blank,
# the dev server falls back to fixed insecure values with a warning -- fine for
# local testing, never for anything reachable by anyone else.
JWT_SECRET=
ENCRYPTION_KEY=
JWT_TTL_SECONDS=43200
JWT_TTL_REMEMBER_SECONDS=2592000

# --- Local dev database and file storage --------------------------------------
# Defaults to worker/data/dev.db and worker/data/uploads if left blank.
DEV_SQLITE_PATH=
DEV_UPLOAD_DIR=

UPLOAD_MAX_BYTES=52428800
DOWNLOAD_URL_TTL_SECONDS=900

# --- Microsoft Graph / Outlook calendar (optional, local dev) -----------------
# Per-customer app-registration client id/secret are entered in the app's own
# Settings -> Outlook calendar screen and stored encrypted in D1 -- not here.
# This is only the redirect URI Microsoft sends the browser back to; register
# it in Azure as a Web platform redirect on your app registration.
MICROSOFT_REDIRECT_URI=http://localhost:8788/api/calendar/microsoft/callback

# --- Tenant provisioned by `npm run seed` -------------------------------------
DEFAULT_CUSTOMER_SLUG=unh-ecenter
DEFAULT_CUSTOMER_NAME=UNH Entrepreneurship Center
