###############################################################################
# UNH ECenter CRM -- environment template
# Copy to .env and fill in. Every value below has a safe local default except
# the two secrets, which MUST be set for a production deployment.
###############################################################################

NODE_ENV=development
PORT=4000

# Public URL of the React client. Used in the OAuth callback page link.
APP_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Secrets -----------------------------------------------------------------
# Generate each with: openssl rand -hex 32
# JWT_SECRET signs session tokens. ENCRYPTION_KEY encrypts OAuth secrets and
# calendar tokens at rest (AES-256-GCM). Rotating ENCRYPTION_KEY invalidates
# stored Microsoft tokens -- customers simply reconnect Outlook.
JWT_SECRET=
ENCRYPTION_KEY=
JWT_TTL_SECONDS=43200
JWT_TTL_REMEMBER_SECONDS=2592000

# --- Database ----------------------------------------------------------------
# Leave DATABASE_URL empty for local development: the server falls back to
# node:sqlite at SQLITE_PATH. Set DATABASE_URL to use PostgreSQL (production).
DATABASE_URL=
# DATABASE_URL=postgresql://user:password@localhost:5432/ecenter_crm?sslmode=require
# DB_DRIVER=postgres
SQLITE_PATH=
PG_POOL_MAX=10

# --- Document storage --------------------------------------------------------
# STORAGE_DRIVER=local writes to server/data/uploads (no cloud account needed).
# STORAGE_DRIVER=r2 uses Cloudflare R2 over the S3 API.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=crm-documents
# Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
UPLOAD_MAX_BYTES=52428800
DOWNLOAD_URL_TTL_SECONDS=900

# --- Microsoft Graph / Outlook calendar --------------------------------------
# Per-customer credentials are entered in Settings and stored encrypted; these
# are optional bootstrap defaults. Register the redirect URI below in Azure as
# a Web platform redirect on your app registration.
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/calendar/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Tenant provisioned by `npm run seed` ------------------------------------
DEFAULT_CUSTOMER_SLUG=unh-ecenter
DEFAULT_CUSTOMER_NAME=UNH Entrepreneurship Center
